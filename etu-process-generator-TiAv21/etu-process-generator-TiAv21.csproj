  <Target Name="ValidateTiaV21Api" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('%(TiaV21RequiredApi.Identity)')" Text="Required TIA Portal V21 API file missing: %(TiaV21RequiredApi.Identity). Set TiaV21ApiDirectory to the installed V21 net48 API directory." />
  </Target>
  <!-- Siemens V21 local help: Connecting to the TIA Portal (37752246795.htm).
       Copy Local is unsupported. Bind before any Siemens type loads, without changing Program.cs. -->
  <Target Name="PrepareTiaV21RuntimeConfig" BeforeTargets="PrepareForBuild" DependsOnTargets="ValidateTiaV21Api">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <PropertyGroup>
      <AppConfig>$(IntermediateOutputPath)TIA.V21.App.config</AppConfig>
    </PropertyGroup>
    <Copy SourceFiles="App.config" DestinationFiles="$(AppConfig)" />
    <XmlPoke XmlInputPath="$(AppConfig)"
             Query="//*[local-name()='dependentAssembly'][*[local-name()='assemblyIdentity']/@name='%(TiaV21RequiredApi.Filename)']/*[local-name()='codeBase']/@href"
             Value="file:///%(TiaV21RequiredApi.FullPath)" />
    <ItemGroup>
      <FileWrites Include="$(AppConfig)" />
    </ItemGroup>
  </Target>
